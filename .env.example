# Email delivery via Resend
# Create an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=re_xxxxxxxxx
# Example: That's Okay. <hello@thatsokay.ie>
RESEND_FROM_EMAIL=That's Okay. <hello@thatsokay.ie>

# Optional: if set, the testimonial submission page requires this access code.
# Leave blank to allow anyone with the submission link to submit.
TESTIMONIAL_ACCESS_CODE=
